{
  "$id": "https://github.com/rohityellapu/Privacy-Posture-Framework",
  "title": "Privacy Posture Framework Use-Case Schema",
  "description": "Structural schema for organisational privacy posture use-case definitions.",
  "type": "object",
  "required": [
    "use_case_id",
    "use_case_name",
    "schema_version",
    "description",
    "organisation",
    "environment",
    "system",
    "data_flows",
    "personal_data"
  ],

  "properties": {

    "use_case_id": {
      "type": "string",
      "pattern": "^UC[0-9]{3}$"
    },

    "use_case_name": {
      "type": "string",
      "minLength": 2
    },

    "schema_version": {
      "type": "string"
    },

    "description": {
      "type": "string"
    },

    "organisation": {
      "$ref": "#/$defs/organisation"
    },

    "environment": {
      "$ref": "#/$defs/environment"
    },

    "system": {
      "$ref": "#/$defs/system"
    },

    "data_flows": {
      "$ref": "#/$defs/dataFlows"
    },

    "personal_data": {
      "$ref": "#/$defs/personalData"
    }
  },

  "$defs": {

    "organisation": {
      "type": "object",
      "required": [
        "name",
        "type",
        "regulatory_context",
        "data_controller"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "regulatory_context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_controller": {
          "type": "boolean"
        },
        "dpo_appointed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },

    "environment": {
      "type": "object",
      "required": [
        "encryption",
        "authentication",
        "access_control",
        "policies"
      ],
      "properties": {

        "encryption": {
          "$ref": "#/$defs/encryption"
        },

        "authentication": {
          "$ref": "#/$defs/authentication"
        },

        "access_control": {
          "$ref": "#/$defs/accessControl"
        },

        "anonymisation": {
          "type": "object",
          "additionalProperties": true
        },

        "policies": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "string",
              "number"
            ]
          }
        },

        "consent_management": {
          "type": "object",
          "additionalProperties": true
        }
      },

      "additionalProperties": true
    },

    "encryption": {
      "type": "object",
      "required": [
        "at_rest",
        "in_transit"
      ],
      "properties": {

        "at_rest": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "algorithm": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },

        "in_transit": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "protocol": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },

        "key_management": {
          "type": "object",
          "properties": {
            "rotation_days": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      },

      "additionalProperties": true
    },

    "authentication": {
      "type": "object",
      "properties": {
        "mfa_required": {
          "type": "boolean"
        },
        "mfa_method": {
          "type": "string"
        },
        "password_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "session_timeout_minutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },

    "accessControl": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "least_privilege": {
          "type": "boolean"
        },
        "audit_logging": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },

    "system": {
      "type": "object",
      "required": [
        "infrastructure",
        "assets",
        "interconnections"
      ],
      "properties": {

        "infrastructure": {
          "type": "object",
          "additionalProperties": true
        },

        "assets": {
          "type": "object",
          "properties": {
            "data_stores": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "applications": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "services": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },

        "interconnections": {
          "type": "object",
          "additionalProperties": true
        }
      },

      "additionalProperties": true
    },

    "dataFlows": {
      "type": "object",

      "required": [
        "collection",
        "storage",
        "access",
        "sharing",
        "retention",
        "deletion"
      ],

      "properties": {

        "collection": {
          "type": "object",
          "required": [
            "methods",
            "data_minimisation"
          ],
          "properties": {
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "consent_captured": {
              "type": "boolean"
            },
            "data_minimisation": {
              "type": "boolean"
            },
            "lawful_basis": {
              "$ref": "#/$defs/lawfulBasis"
            }
          },
          "additionalProperties": true
        },

        "storage": {
          "type": "object",
          "additionalProperties": true
        },

        "access": {
          "type": "object",
          "additionalProperties": true
        },

        "sharing": {
          "type": "object",
          "properties": {
            "recipients": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "legal_basis": {},
            "dpa_in_place": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },

        "retention": {
          "type": "object",
          "additionalProperties": true
        },

        "deletion": {
          "type": "object",
          "additionalProperties": true
        }
      },

      "additionalProperties": true
    },

    "lawfulBasis": {
      "type": "object",
      "required": [
        "article_6_basis"
      ],
      "properties": {
        "article_6_basis": {
          "type": "string"
        },
        "article_9_condition": {
          "type": "string"
        },
        "dpa_schedule_1_condition": {
          "type": "string"
        },
        "consent_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },

    "personalData": {
      "type": "object",
      "required": [
        "categories_in_use"
      ],
      "properties": {
        "categories_in_use": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "special_category_data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },

  "additionalProperties": false
}