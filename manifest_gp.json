{
  "manifest_id": "MAN-UC001",
  "use_case_id": "UC001",
  "use_case_name": "GP Surgery",
  "manifest_version": "1.0",
  "created_date": "2026-08-10",
  "description": "Privacy posture manifest declaring the required privacy controls for a GP Surgery. This manifest defines the minimum expected controls for compliance with GDPR, NHS DSPT, and UK DPA 2018.",
  "required_controls": {
    "encryption": {
      "at_rest_required": true,
      "at_rest_min_algorithm": "AES-256",
      "in_transit_required": true,
      "in_transit_min_protocol": "TLS 1.2",
      "key_rotation_max_days": 90
    },
    "authentication": {
      "mfa_required": true,
      "min_password_length": 12,
      "session_timeout_max_minutes": 30
    },
    "access_control": {
      "rbac_required": true,
      "least_privilege_required": true,
      "audit_logging_required": true,
      "break_glass_procedure_required": true
    },
    "pseudonymisation": {
      "required": true,
      "acceptable_techniques": ["tokenisation", "hashing"]
    },
    "policies": {
      "privacy_policy_published": true,
      "data_retention_policy": true,
      "breach_response_plan": true,
      "staff_training": true,
      "dsar_procedure": true
    },
    "consent": {
      "explicit_consent_required": true,
      "withdrawal_mechanism_required": true,
      "consent_audit_trail_required": true
    },
    "data_flows": {
      "collection": {"consent_at_collection": true, "data_minimisation": true},
      "storage": {"encrypted": true, "uk_only": true, "daily_backup": true},
      "access": {"logged": true, "authenticated": true, "role_restricted": true},
      "sharing": {"dpa_required": true, "legal_basis_documented": true},
      "retention": {"policy_defined": true},
      "deletion": {"secure_deletion": true, "audit_trail": true}
    },
    "data_categories_allowed": [
      "full_name", "date_of_birth", "email_address", "phone_number", "postal_address",
      "patient_id", "health_data", "prescriptions", "diagnosis", "lab_results",
      "vaccination_records", "allergies", "national_id_number"
    ],
    "special_category_data": {
      "health_data_permitted": true,
      "lawful_basis_required": "Article 9(2)(h) GDPR"
    },
    "compliance_standards": ["GDPR", "NHS_DSPT", "UK_DPA_2018", "Caldicott_Principles"],
    "dpo_required": true,
    "pia_required": true
  },
  "non_negotiable_controls": [
    "at_rest_encryption",
    "in_transit_encryption",
    "mfa",
    "rbac_with_least_privilege",
    "pseudonymisation",
    "access_audit_logging",
    "breach_response_plan",
    "dpo_appointed",
    "consent_mechanism"
  ]
}
