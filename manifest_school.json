{
  "manifest_id": "MAN-UC002",
  "use_case_id": "UC002",
  "use_case_name": "School",
  "manifest_version": "1.0",
  "created_date": "2026-08-10",
  "description": "Privacy posture manifest declaring required controls for a secondary school managing pupil records and educational data. Aligned with GDPR, UK DPA 2018, and DfE Data Protection guidance.",
  "required_controls": {
    "encryption": {
      "at_rest_required": true,
      "at_rest_min_algorithm": "AES-256",
      "in_transit_required": true,
      "in_transit_min_protocol": "TLS 1.2",
      "key_rotation_max_days": 180
    },
    "authentication": {
      "mfa_required": true,
      "min_password_length": 10,
      "session_timeout_max_minutes": 60,
      "parental_portal_2fa": true
    },
    "access_control": {
      "rbac_required": true,
      "least_privilege_required": true,
      "audit_logging_required": true,
      "safeguarding_restricted_access": true
    },
    "pseudonymisation": {
      "required": true,
      "acceptable_techniques": ["tokenisation", "hashing", "anonymisation"]
    },
    "policies": {
      "privacy_policy_published": true,
      "data_retention_policy": true,
      "breach_response_plan": true,
      "staff_training": true,
      "dsar_procedure": true,
      "parental_consent_forms": true,
      "acceptable_use_policy": true
    },
    "consent": {
      "explicit_consent_required": true,
      "parental_consent_for_minors": true,
      "withdrawal_mechanism_required": true,
      "consent_audit_trail_required": true
    },
    "data_flows": {
      "collection": {"consent_at_collection": true, "parental_consent": true, "data_minimisation": true},
      "storage": {"encrypted": true, "uk_only": true, "daily_backup": true},
      "access": {"logged": true, "authenticated": true, "role_restricted": true, "safeguarding_extra_restriction": true},
      "sharing": {"dpa_required": true, "legal_basis_documented": true, "npd_reporting_compliant": true},
      "retention": {"pupil_records_max_years_after_leaving": 7, "safeguarding_max_years": 25},
      "deletion": {"secure_deletion": true, "audit_trail": true}
    },
    "data_categories_allowed": [
      "full_name", "date_of_birth", "student_id", "email_address", "postal_address",
      "gender", "grades", "attendance_records", "disciplinary_records",
      "special_educational_needs", "examination_results", "safeguarding_notes",
      "parent_contact_details", "free_school_meal_eligibility", "medical_conditions"
    ],
    "special_category_data": {
      "health_data_permitted": true,
      "sen_data_permitted": true,
      "lawful_basis_required": "Article 6(1)(e) / Article 9(2)(b) GDPR"
    },
    "compliance_standards": ["GDPR", "UK_DPA_2018", "KCSIE", "DfE_Data_Protection_Guidance"],
    "dpo_required": true,
    "pia_required": false
  },
  "non_negotiable_controls": [
    "at_rest_encryption",
    "in_transit_encryption",
    "mfa",
    "rbac_with_least_privilege",
    "safeguarding_restricted_access",
    "consent_mechanism",
    "parental_consent_for_minors",
    "breach_response_plan",
    "staff_training"
  ]
}
